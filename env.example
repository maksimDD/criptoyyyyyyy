# Required in production. Generate a random value, e.g. openssl rand -hex 48
SESSION_SECRET=replace-with-a-long-random-secret

# Admin password (never commit the real value)
BLUP_ADMIN_PASSWORD=replace-with-a-unique-long-admin-password

# Two Telegram notification bots. Both receive registrations, sales and promo alerts.
TELEGRAM_BOT_1_TOKEN=
TELEGRAM_BOT_1_CHAT_ID=
TELEGRAM_BOT_2_TOKEN=
TELEGRAM_BOT_2_CHAT_ID=

# Bot used by Telegram Login Widget / Telegram Login API.
# This bot must be configured with /setdomain in @BotFather for the exact production domain.
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=

# Set to 1 only when the hosting platform is behind a trusted reverse proxy.
TRUST_PROXY=1
NODE_ENV=production
