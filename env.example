# Required in production. Generate a random value, e.g. openssl rand -hex 48
SESSION_SECRET=replace-with-a-long-random-secret

# Admin password (do not commit the real value)
BLUP_ADMIN_PASSWORD=replace-with-a-unique-long-admin-password

# Optional Telegram notifications. Rotate old tokens before using these.
TELEGRAM_BOT_TOKEN=
REGISTER_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT=

# Set to 1 only when the hosting platform is behind a trusted reverse proxy.
TRUST_PROXY=1

NODE_ENV=production
