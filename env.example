# Production database file on Amvera's persistent storage
DB_PATH=/data/data.db

# Required in production: set a long random secret in Amvera environment variables.
SESSION_SECRET=replace-with-a-long-random-secret
BLUP_ADMIN_PASSWORD=replace-with-a-unique-long-admin-password

# Sales / withdrawal / promo notifications (two bot + chat pairs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT=
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_ADMIN_CHAT_2=

# Registration notifications. If omitted, each pair falls back to the matching
# TELEGRAM_BOT_TOKEN(_2) and TELEGRAM_ADMIN_CHAT(_2) pair above.
REGISTER_BOT_TOKEN=
REGISTER_ADMIN_CHAT=
REGISTER_BOT_TOKEN_2=
REGISTER_ADMIN_CHAT_2=

# Set to 1 only if the hosting platform is behind a trusted reverse proxy.
TRUST_PROXY=1
NODE_ENV=production
